# ==============================================================================
# Homelab Environment Configuration Template (.env.example)
# Rename this file to .env and fill in your values. NEVER commit the real .env!
# ==============================================================================

# Timezone & Localization
TIMEZONE=America/Vancouver
PUID=1000
PGID=1000

# Base Storage Mount Points (NFS / ZFS local mount on host)
STORAGE_PATH=/mnt/storage/data

# Homelab Subnet (CIDR format, used for Gluetun firewall bypass)
HOMELAB_SUBNET=192.168.1.0/24

# VPN Shield Configuration (Gluetun)
# Supports: custom, protonvpn, mullvad, surfshark, pia, windscribe, etc.
VPN_PROVIDER=custom
VPN_COUNTRY=Canada
WIREGUARD_PRIVATE_KEY=<YOUR_BASE64_WIREGUARD_PRIVATE_KEY>
WIREGUARD_ADDRESSES=10.2.0.2/32

# Proxmox Host & Hypervisor Connection
PVE_HOST_IP=192.168.1.250
PVE_API_USER=root@pam
PVE_API_TOKEN_ID=<YOUR_PVE_TOKEN_NAME>
PVE_API_TOKEN_SECRET=<YOUR_PVE_TOKEN_UUID>

# Database Passwords (Choose strong unique passwords)
POSTGRES_USER=homelab_admin
POSTGRES_PASSWORD=<STRONG_RANDOM_POSTGRES_PASSWORD>
REDIS_PASSWORD=<STRONG_RANDOM_REDIS_PASSWORD>

# Paperless-ngx Configuration
PAPERLESS_SECRET_KEY=<RANDOM_HEX_64_CHAR_KEY>
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=<STRONG_PAPERLESS_PASSWORD>
PAPERLESS_ADMIN_EMAIL=admin@example.com

# Firefly III Financial Management
FIREFLY_APP_KEY=<RANDOM_BASE64_32_CHAR_KEY>
FIREFLY_DB_PASSWORD=<STRONG_RANDOM_DB_PASSWORD>

# Telegram Notification Bot Configuration
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN_FROM_BOTFATHER>
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>
