# ── WebAuthn / Passkey & Origin Configuration ────────────────────────────────
RP_ID=<TAILSCALE_GATEWAY_MAGICDNS>
ORIGIN=https://<TAILSCALE_GATEWAY_MAGICDNS>:8443
WEB_PORT=8080
RP_NAME=openGym Homelab

# ── User Access & Security Isolation ──────────────────────────────────────────
FIRST_USER_ADMIN=1
INVITE_ONLY=1
ALLOW_GUEST=0
SESSION_DAYS=90

# ── Media & Reverse Proxy Settings ────────────────────────────────────────────
MEDIA_UPLOADS=1
MEDIA_QUOTA_MB=500
TRUST_PROXY=1
