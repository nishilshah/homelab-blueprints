# ==========================================
# Paperless-ngx Configuration (.env.example)
# ==========================================

TIMEZONE=America/Vancouver
STORAGE_ROOT=/mnt/paperless

# Security Secrets (Generate using: openssl rand -hex 32)
PAPERLESS_SECRET_KEY=<RANDOM_HEX_64_CHAR_KEY>
DB_PASSWORD=<STRONG_RANDOM_POSTGRES_PASSWORD>

# Administrative Setup
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_EMAIL=admin@example.com
PAPERLESS_ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>
