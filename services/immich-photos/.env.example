# ==========================================
# Immich Configuration (.env.example)
# ==========================================

# Software Release Version
IMMICH_VERSION=release

# Primary Storage Location (NFS mount from TrueNAS)
UPLOAD_LOCATION=/mnt/photos/upload

# Database Directory & Passwords
DB_DATA_LOCATION=./postgres_data
DB_DATABASE_NAME=immich
DB_USERNAME=postgres
DB_PASSWORD=<STRONG_RANDOM_POSTGRES_PASSWORD>

# Machine Learning & AI Features
IMMICH_MACHINE_LEARNING_WORKERS=2
IMMICH_MACHINE_LEARNING_MODEL_TTL=300
