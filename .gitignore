# ==========================================
# Homelab Blueprints - Security & Ignore Rules
# ==========================================

# Secrets, Environment Files & Keys
.env
.env.local
.env.*.local
*.secret
*.secrets
*.key
*.pem
*.token
*.cert
*.crt
*credentials*
*matrix*
authorized_users.json
config.json
monitor_state.json

# Exclude any private SSH or SSL material
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
known_hosts
*.p12

# Database & Runtime Data
*.sqlite
*.sqlite3
*.db
*.rrd
*.dump

# Logs & Runtime State
*.log
*.pid
*.seed
*.pid.lock

# Python & Node Runtime
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
node_modules/

# OS Artifacts
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

# Allow templates and examples
!.env.example
!templates/
